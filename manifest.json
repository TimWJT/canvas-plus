{
  "manifest_version": 3,
  "name": "More Settings for Canvas",
  "version": "1.0.1",
  "description": "Dark mode, assignments on course cards, a better to-do list, dashboard notes, due-date reminders and bulk course-file downloads for Canvas LMS. Based on Better Canvas.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "action": {
    "default_icon": "icon.svg",
    "default_popup": "html/popup.html",
    "default_title": "More Settings for Canvas"
  },
  "background": {
    "scripts": [
      "js/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://canvas.sydney.edu.au/*"
      ],
      "js": [
        "js/reminders.js",
        "js/content.js"
      ],
      "css": [
        "css/content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*/*"
      ],
      "exclude_matches": [
        "https://*.instructure.com/*",
        "https://canvas.sydney.edu.au/*"
      ],
      "js": [
        "js/reminders.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "more-settings-for-canvas@timwjt",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://canvas.sydney.edu.au/*"
  ],
  "sidebar_action": {
    "default_panel": "html/downloader.html?sidebar=1",
    "default_title": "Canvas downloads",
    "default_icon": "icon.svg",
    "open_at_install": false
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
